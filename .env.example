# Supabase API mode: these two settings are enough to run the web app.
# Keep the service role key on the Next.js server only.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct PostgreSQL mode. When set, this takes priority over API mode.
# Dashboard > Connect > Transaction pooler (port 6543) on serverless hosting.
DATABASE_URL=
# Separate random secret for signed cookies, 32+ characters.
SESSION_SECRET=
# Single administrator account. Change the password before production use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional Web Push. Leave all blank to disable push notifications.
# Generate a new pair: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
