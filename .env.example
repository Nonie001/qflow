# Deploy google-apps-script/Code.gs as a Web App. See README.md.
GOOGLE_APPS_SCRIPT_URL=
# Same value as API_SECRET in Apps Script Script Properties (32+ random characters).
GOOGLE_APPS_SCRIPT_SECRET=
# Separate random secret for signed cookies, 32+ characters.
SESSION_SECRET=
# Single administrator account. Change the password before production use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional Web Push. Leave all blank to disable push notifications.
# Generate a new pair: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
